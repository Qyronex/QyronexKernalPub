    "chdir": { "number": 49, "args": ["user_path"] },
    "fchdir": { "number": 50, "args": ["fd"] },
    "fchmod": { "number": 52, "args": ["fd", "mode"] },
    "fchmodat": { "number": 53, "args": ["dirfd", "user_path", "mode"] },
    "fchownat": { "number": 54, "args": ["dirfd", "user_path", "owner", "group", "flags"] },
    "fchown": { "number": 55, "args": ["fd", "owner", "group"] },
    "openat": { "number": 56, "args": ["dirfd", "user_path", "flags", "mode"] },
    "pwrite64": { "number": 68, "args": ["fd", "user_buffer", "count", "offset"] },
    "readlinkat": { "number": 78, "args": ["dirfd", "user_path", "user_buffer", "buffer_size"] },
    "utimensat": { "number": 88, "args": ["dirfd", "user_path", "user_times", "flags"] },
