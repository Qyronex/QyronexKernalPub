{
  "schema_version": 3,
  "architecture": "aarch64",
  "active_step": 29,
  "coordination_issue": 848,
  "purpose": "Frozen scalar ABI and Linux-visible edge contract for the final Step-29 cwd, writable-file, namespace-mutation and metadata slice.",
  "scope": {
    "classifier_is_authority_free": true,
    "classifier_preserves_raw_x0_x5_register_bits": true,
