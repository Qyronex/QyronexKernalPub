    "faccessat2": { "number": 439, "args": ["dirfd", "user_path", "mode", "flags"] }
  },
  "declared_width_policy": {
    "classifier": "Preserve every syscall argument as the exact raw u64 AArch64 register value; no C-width truncation or sign extension occurs in classify_fs.",
    "semantic_owner": "Decode Linux C int/unsigned int/mode_t/uid_t/gid_t low 32 bits and signed off_t only after classification, before semantic validation or state mutation.",
    "linux_signed_int": "semantic owner consumes low 32 bits then reinterprets as i32",
    "linux_unsigned_int": "semantic owner consumes low 32 bits as u32",
    "linux_mode_t": "semantic owner consumes low 32 bits as u32",
    "linux_uid_gid": "semantic owner consumes low 32 bits as u32; uid/gid metadata never grants Kernal capability authority",
    "linux_signed_off_t": "semantic owner reinterprets the full 64-bit register as i64",
    "linux_u64": "full u64 remains unchanged for pointers and size_t",
    "signed_int_fields": [
      "mkdirat.dirfd", "unlinkat.dirfd", "unlinkat.flags", "symlinkat.newdirfd",
      "linkat.olddirfd", "linkat.newdirfd", "linkat.flags", "renameat.olddirfd",
      "renameat.newdirfd", "ftruncate.fd", "faccessat.dirfd", "faccessat.mode",
      "fchdir.fd", "fchmod.fd", "fchmodat.dirfd", "fchownat.dirfd", "fchownat.flags",
      "fchown.fd", "openat.dirfd", "pwrite64.fd", "readlinkat.dirfd", "utimensat.dirfd",
      "utimensat.flags", "renameat2.olddirfd", "renameat2.newdirfd", "statx.dirfd",
      "statx.flags", "openat2.dirfd", "faccessat2.dirfd", "faccessat2.mode", "faccessat2.flags"
    ],
    "unsigned_int_fields": ["renameat2.flags", "statx.mask"],
    "mode_fields": ["mkdirat.mode", "fchmod.mode", "fchmodat.mode", "openat.mode", "umask.mask"],
    "uid_gid_fields": ["fchownat.owner", "fchownat.group", "fchown.owner", "fchown.group"],
    "signed_64_fields": ["truncate.length", "ftruncate.length", "pwrite64.offset"],
    "tests_require_hostile_upper_register_bits_to_survive_classifier": true
  },
  "constants": {
