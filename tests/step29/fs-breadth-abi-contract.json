  },
  "required_error_and_state_semantics": [
    { "case": "relative_path_uses_process_cwd_not_root", "expect": "cwd-relative resolution" },
    { "case": "getcwd_success_length", "expect": "absolute_path_bytes_plus_terminating_NUL; return_length_includes_NUL" },
    { "case": "getcwd_buffer_too_small", "expect": "ERANGE" },
    { "case": "getcwd_result_exceeds_PATH_MAX_including_NUL", "expect": "ENAMETOOLONG" },
    { "case": "fchdir_non_directory", "expect": "ENOTDIR" },
    { "case": "pwrite_negative_offset", "expect": "EINVAL" },
    { "case": "pwrite_does_not_mutate_ofd_offset", "expect": "offset unchanged" },
    { "case": "write_through_duplicated_regular_file", "expect": "shared OFD position" },
    { "case": "unlinkat_directory_without_AT_REMOVEDIR", "expect": "EISDIR" },
    { "case": "unlinkat_non_directory_with_AT_REMOVEDIR", "expect": "ENOTDIR" },
    { "case": "renameat2_unknown_flags", "expect": "EINVAL" },
    { "case": "rename_noreplace_existing_target", "expect": "EEXIST" },
    { "case": "linkat_cross_filesystem", "expect": "reference_only_EXDEV_until_distinct_mount_identity_exists" },
    { "case": "openat2_resolve_zero", "expect": "accepted_for_further_open_validation" },
    { "case": "openat2_RESOLVE_BENEATH", "expect": "EINVAL" },
    { "case": "openat2_other_known_nonzero_resolve_bits", "expect": "EINVAL" },
    { "case": "openat2_unknown_resolve_bits", "expect": "EINVAL" },
    { "case": "openat2_short_struct", "expect": "EINVAL" },
    { "case": "openat2_nonzero_unknown_extension", "expect": "E2BIG" },
    { "case": "dotdot_above_process_root", "expect": "clamped_to_process_root" },
    { "case": "relative_symlink_dotdot_above_process_root", "expect": "confined_to_process_root" },
    { "case": "write_first_byte_usercopy_fault", "expect": "EFAULT_without_OFD_or_file_state_commit" },
    { "case": "pwrite_first_byte_usercopy_fault", "expect": "EFAULT_without_OFD_or_file_state_commit" },
    { "case": "partial_write_usercopy_fault", "expect": "positive_short_only_for_committed_prefix_and_shared_OFD_advances_by_prefix" },
    { "case": "partial_pwrite_usercopy_fault", "expect": "positive_short_only_for_committed_prefix_and_OFD_position_unchanged" },
    { "case": "bad_writable_fd", "expect": "EBADF_without_file_state_commit" },
    { "case": "umask_return", "expect": "previous_mask_and_new_mask_low_0777_effective" },
    { "case": "uid0_metadata", "expect": "no_ambient_kernal_authority" }
  ],
  "mutation_provenance": {
