  "open_how": {
    "version0_size": 24,
    "field_order": ["flags:u64", "mode:u64", "resolve:u64"],
    "size_smaller_than_version0": "EINVAL",
    "size_equal_to_version0": "accepted_for_further_validation",
    "larger_zero_filled_extension": "accepted_for_further_validation",
